{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --config jest.config.cjs",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs",
    "test:evaluation": "tsx test/evaluation/run.ts",
    "db:migrate": "pnpm build && node dist/database/manage.js migrate",
    "db:snapshot": "pnpm build && node dist/database/manage.js snapshot",
    "db:sync-documents": "pnpm build && node dist/database/sync-documents.js",
    "verify:live": "pnpm build && node dist/database/verify-live.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "openai": "7.27.0",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
