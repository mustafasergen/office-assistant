# Optional: docker compose up works without .env (mock + local PostgreSQL).
# Copy to .env for private settings. Never commit .env.
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Blank: Compose uses postgres:5432; local Node uses localhost:5432.
DATABASE_URL=
# Supabase session pooler example; percent-encode reserved password characters:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require

# Replace for private environments: openssl rand -hex 32
COOKIE_SECRET=uplico-local-demo-cookie-secret-change-for-deployment
COOKIE_SECURE=false

# Optional deployment settings (normally no changes needed).
FRONTEND_PORT=3000
PORT=3001
POSTGRES_USER=uplico
POSTGRES_PASSWORD=uplico
POSTGRES_DB=uplico
# Local Node frontend only; Compose sets this to http://backend:3001.
BACKEND_INTERNAL_URL=http://localhost:3001

# Model names, retrieval thresholds and agent limits: backend/src/config/defaults.ts
